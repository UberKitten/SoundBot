# Docker
DOCKERLOGGING_MAXFILE='10'
DOCKERLOGGING_MAXSIZE='200k'
DOCKERHOSTNAME='yourserver'
PGID='1000'
PUID='1000'
TZ='America/Los_Angeles'
DOCKERCONFDIR='.config/appdata'

# Web
SOUNDBOT_PORT_8080='8080'

# Branding (optional — shown in browser tab, PWA install, and API docs)
APP_TITLE='Soundboard'
# Short PWA name (defaults to APP_TITLE; keep <=12 chars for best mobile display)
APP_SHORT_TITLE=''

# Public URL of the web UI (used in webhook embed links)
WEB_UI_URL='sounds.uberkitten.com'

# Client
TOKEN=''
TEST_GUILD_IDS='123,456'

# Shared bgutil POT provider for YouTube downloads.
YTDLP_POT_PROVIDER_URL='http://192.168.0.10:4416'
# Optional client-local cookies file. Anonymous yt-dlp is always attempted first;
# if that fails, this file is used once when it exists. For Docker, bind-mount
# the host file read-only at this path.
YTDLP_COOKIES_FILE='/run/secrets/yt-dlp-cookies.txt'

# Discord webhook for sound add/delete notifications (optional)
DISCORD_WEBHOOK_URL=''

# --- Discord OAuth admin login (optional) ---
# When these are unset, the site stays anonymous/read-only and the auth
# endpoints return 503. Set all three to enable admin login via Discord.
# Anyone who is a member of a server the bot is in becomes an admin.
#
# From the Discord Developer Portal (https://discord.com/developers/applications):
#   - DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET: from your app's OAuth2 page.
#   - In OAuth2 → Redirects, add: <OAUTH_REDIRECT_BASE>/api/auth/callback
#     (e.g. https://sounds.uberkitten.com/api/auth/callback)
DISCORD_CLIENT_ID=''
DISCORD_CLIENT_SECRET=''
# Any long random string used to sign session cookies AND public clip links
# (/clips/... URLs posted by the /clip command), e.g. `openssl rand -hex 32`.
# Rotating it logs out admins and invalidates previously posted clip links.
SESSION_SECRET=''
# Base URL for OAuth redirects. If unset, derived as https://<WEB_UI_URL>.
# Set this if the public URL differs from WEB_UI_URL (e.g. includes a port).
OAUTH_REDIRECT_BASE=''
# How many days an admin login stays valid (default 30).
ADMIN_SESSION_DAYS='30'