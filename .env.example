# Docker
DOCKERLOGGING_MAXFILE='10'
DOCKERLOGGING_MAXSIZE='200k'
DOCKERHOSTNAME='yourserver'
PGID='1000'
PUID='1000'
TZ='America/Los_Angeles'
DOCKERCONFDIR='.config/appdata'

# Web
SOUNDBOT_PORT_8080='8080'

# Branding (optional — shown in browser tab, PWA install, and API docs)
APP_TITLE='Soundboard'
# Short PWA name (defaults to APP_TITLE; keep <=12 chars for best mobile display)
APP_SHORT_TITLE=''

# Public URL of the web UI (used in webhook embed links)
WEB_UI_URL='sounds.uberkitten.com'

# Client
TOKEN=''
TEST_GUILD_IDS='123,456'

# Discord webhook for sound add/delete notifications (optional)
DISCORD_WEBHOOK_URL=''